@inject NavigationManager NavManager
@inject AuthenticationStateProvider Authorized
@inject GlobalService AppGlobals

@code {
    private AppliedGlobals.AppUserModel? AppUser { get; set; }
    private string? AppUserName { get; set; }
    private string? CompanyName;
    private string SelectedLanguage = "en";
    private bool IsOffcanvasOpen = false;

    // Language Dictionary
    private Dictionary<string, string> Languages => new Dictionary<string, string>
    {
        { "en", "English" },
        { "ar", "العربية" },
        { "ur", "اردو" }
    };

    protected override void OnInitialized()
    {
        AppUser = ((UserAuthenticationStateProvider)Authorized).AppUser;
        CompanyName = AppUser.Company;
        AppUserName = AppUser.DisplayName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Task.Run(() =>
        {
            AppUser = ((UserAuthenticationStateProvider)Authorized).AppUser;
            CompanyName = AppUser.Company;
            AppUserName = AppUser.DisplayName;
            InvokeAsync(() => StateHasChanged());

        });
    }

    private void ChangeLanguage(string lang)
    {
        SelectedLanguage = lang;
    }

    private string GetLanguageName() => SelectedLanguage switch
    {
        "en" => "English",
        "ar" => "العربية",
        "ur" => "اردو",
        _ => "English"
    };

    public string GetCompanyName() { return AppUser.Company ?? ""; }
    public string GetAppUserName() => AppUser.DisplayName ?? "";
    public void GoHome() { NavManager.NavigateTo("/"); }

    private void ToggleOffcanvas()
    {
        IsOffcanvasOpen = !IsOffcanvasOpen;
    }

    private string EnterKey = "Enter";

    public void NavigateToConfig()
    {
        NavManager.NavigateTo("/Config");
    }

    private async Task OpenGeneralSetting()
    {
        // Close offcanvas using JS
        await AppGlobals.JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
        
        // Wait for offcanvas to close
        await Task.Delay(400);
        
        // Open the modal
        await AppGlobals.JS.InvokeVoidAsync("openGlobalModal", "Setting1");
    }

    private void HandleButtonClick(string buttonName)
    {
        Console.WriteLine($"{buttonName} clicked");
    }

    private void OnButton1Click() => HandleButtonClick("Button 1");
    private void OnButton2Click() => HandleButtonClick("Button 2");
    private void OnButton3Click() => HandleButtonClick("Button 3");
    private void OnButton4Click() => HandleButtonClick("Button 4");
    private void OnSaveClick() => HandleButtonClick("Save Changes");
}

<header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow sticky-top" data-bs-theme="dark">
    <div class="logo-img" @onclick="GoHome">
        <img src="Images/ASH3.png" class="img-thumbnail brand-Width" alt="..." title="Go Home" />
    </div>
    <div class="text-white p-2 fs-3 fw-bold ComTitle">APPLIED ACCOUNTS 2</div>

    <div class="ms-auto d-flex align-items-center gap-2">

        <AuthorizeView>
            <NotAuthorized>
                <Btn_Login />
            </NotAuthorized>
            <Authorized>

                <div class="justify-content-end text-white d-none d-md-block">
                    @GetCompanyName()
                </div>

                <!-- Language Dropdown on Page -->
                <div class="dropdown">
                    <button class="btn btn-outline-light btn-sm dropdown-toggle"
                            type="button"
                            id="languageDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <span class="d-none d-md-inline">@GetLanguageName()</span>
                        <span class="d-inline d-md-none">🌐</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                        @foreach (var lang in Languages)
                        {
                            <li>
                                <a class="dropdown-item @(SelectedLanguage == lang.Key ? "active" : "")"
                                   href="#"
                                   @onclick="() => ChangeLanguage(lang.Key)"
                                   @onclick:preventDefault="true">
                                    @lang.Value
                                    @if (SelectedLanguage == lang.Key)
                                    {
                                        <i class="bi bi-check2 ms-2"></i>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Settings Gear Icon -->
                <div class="p-1">
                    <span class="p-2 rounded-circle"
                          type="button"
                          data-bs-toggle="offcanvas"
                          data-bs-target="#offcanvasRight"
                          aria-controls="offcanvasRight"
                          role="button"
                          tabindex="0"
                          @onclick="ToggleOffcanvas"
                          @onkeydown="e => { if (e.Code == EnterKey) ToggleOffcanvas(); }">
                        <i class="bi bi-gear text-white"></i>
                    </span>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<!-- Offcanvas Panel -->
<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasRight"
     aria-labelledby="offcanvasRightLabel"
     data-bs-backdrop="true"
     data-bs-scroll="false">
    <div class="offcanvas-header bg-dark text-white">
        <h5 class="offcanvas-title" id="offcanvasRightLabel">
            <i class="bi bi-gear me-2"></i>Settings
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <!-- User Info -->
        <div class="mb-4">
            <h6 class="mb-3">User Information</h6>
            <div class="mb-2">
                <small class="text-muted">Name</small>
                <p class="mb-1"><strong>@AppUserName</strong></p>
            </div>
            <div class="mb-2">
                <small class="text-muted">Company</small>
                <p class="mb-1"><strong>@CompanyName</strong></p>
            </div>
        </div>

        <!-- Actions -->
        <div class="mt-4 pt-3 border-top">
            <div class="d-grid gap-2">
                <!-- General Setting Button -->
                <button class="btn btn-primary" @onclick="OpenGeneralSetting">
                    <i class="bi bi-gear me-2"></i>General Setting
                </button>

                <!-- Configuration Page Button -->
                <button class="btn btn-outline-danger" @onclick="NavigateToConfig">
                    <i class="bi bi-box-arrow-right me-2"></i>Configuration Page
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="Setting1" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Application Setting</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-primary" @onclick="OnButton1Click">Button 1</button>
                    <button type="button" class="btn btn-secondary" @onclick="OnButton2Click">Button 2</button>
                    <button type="button" class="btn btn-success" @onclick="OnButton3Click">Button 3</button>
                    <button type="button" class="btn btn-warning" @onclick="OnButton4Click">Button 4</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" @onclick="OnSaveClick">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript injected directly in the component -->
<script>
    // Close offcanvas
    window.closeOffcanvas = function(id) {
        var el = document.getElementById(id);
        if (el) {
            var instance = bootstrap.Offcanvas.getInstance(el);
            if (instance) {
                instance.hide();
            }
        }
    };

    // Open global modal
    window.openGlobalModal = function(modalId) {
        var modalElement = document.getElementById(modalId);
        if (!modalElement) return;
        
        // Move to body if needed
        if (modalElement.parentElement && modalElement.parentElement.tagName !== 'BODY') {
            document.body.appendChild(modalElement);
        }

        // Remove existing backdrop
        var existingBackdrop = document.querySelector('.modal-backdrop');
        if (existingBackdrop) {
            existingBackdrop.remove();
        }

        // Show modal
        var modal = new bootstrap.Modal(modalElement, {
            backdrop: 'static',
            keyboard: true
        });
        modal.show();
        window.currentModal = modal;
    };
</script>

<style>
    .navbar {
        max-height: var(--navbar_Size);
    }

    .brand-Width {
        min-height: var(--navbar_Size);
        max-width: var(--navbar_Size);
    }

    .sidebar-width {
        max-height: var(--sidebarMin_Width);
        max-width: var(--sidebarMax_Width);
    }

    .ComTitle {
        font-family: "Exo 2", sans-serif;
    }

    /* Language dropdown styles */
    .dropdown-item.active {
        background-color: #0d6efd;
        color: #fff;
    }

    .dropdown-item.active .text-muted {
        color: rgba(255,255,255,0.7) !important;
    }

    /* Offcanvas styles */
    .offcanvas {
        width: 350px;
        max-width: 90vw;
    }

    .offcanvas-header {
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    [data-bs-theme="dark"] .offcanvas {
        background-color: #1a1d20;
        color: #dee2e6;
    }

    /* Modal z-index fix */
    .modal {
        z-index: 1060 !important;
    }
    
    .modal-backdrop {
        z-index: 1055 !important;
    }
    
    .modal-content {
        z-index: 1065 !important;
        position: relative !important;
    }
    
    .modal-body, .modal-footer {
        z-index: 1070 !important;
        position: relative !important;
    }
    
    .modal-body button, .modal-footer button {
        position: relative;
        z-index: 1075 !important;
        pointer-events: auto !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .navbar {
            padding: 0 0.5rem;
        }
        .ComTitle {
            font-size: 0.9rem !important;
        }
        .brand-Width {
            min-height: 40px;
            max-width: 40px;
        }
        .offcanvas {
            width: 100%;
        }
    }
</style>