@using Microsoft.AspNetCore.Components
@using AppliedGlobals;

@code {
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string UserRole { get; set; } = UsersRole.Administrator.ToString();

    private async Task HandleClick(MouseEventArgs e)
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}

@if (UserRole == UsersRole.Administrator.ToString() || UserRole == UsersRole.Manager.ToString())
{
    <button type="button" id="btn-delete" class="btn btn-link" title="Delete" @onclick="HandleClick">
        <i class="bi bi-trash-fill btn-trash"></i>
    </button>
}
