```razor
@* AppSetting.razor *@
@page "/Setting/General"

@using AppliedAccounts.Component.Libs

@attribute [Authorize]

@inject NavigationManager NavManager
@inject GlobalService AppGlobal
@inject IToastService Toaster

<PageHeading Text="General Setting" />

@* @if (IsAuthorized) *@
@if (true)
{
    <EditForm Model="MyModel" OnValidSubmit="@SaveAsync">

        <div class="container">
            <div class="row">

                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddCashNature"
                                Label="Cash Nature Account"
                                Value="@MyModel.CashNatureID"
                                ValueChanged="CashNatureValueChange"
                                Items="NatureList">
                    </MyDropDown>
                </div>

                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddBankNature"
                                Label="Bank Nature Account"
                                Value="@MyModel.BankNatureID"
                                ValueChanged="BankNatureValueChange"
                                Items="NatureList">
                    </MyDropDown>
                </div>

            </div>

            <div class="row">
                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAP_purchase"
                                Label="Purchase Account"
                                Value="@MyModel.PayableAccounts.Purchase"
                                ValueChanged="APPurchaseValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>
                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAP_Tax"
                                Label="Tax Account"
                                Value="@MyModel.PayableAccounts.Tax"
                                ValueChanged="APTaxValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>

                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAP_Payable"
                                Label="Payable Account"
                                Value="@MyModel.PayableAccounts.Payable"
                                ValueChanged="APPayableValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>

            </div>

            <div class="row">
                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAR_stock"
                                Label="Stock Account"
                                Value="@MyModel.ReceivableAccounts.Stock"
                                ValueChanged="ARStockValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>
                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAR_Tax"
                                Label="Tax Account"
                                Value="@MyModel.ReceivableAccounts.Tax"
                                ValueChanged="ARTaxValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>

                <div class="col-md-3 col-12">
                    <MyDropDown Id="ddAR_Receivable"
                                Label="Receivable Account"
                                Value="@MyModel.ReceivableAccounts.Receivable"
                                ValueChanged="ARReceivableValueChange"
                                Items="AccountList">
                    </MyDropDown>
                </div>

            </div>


            @* Control Buttons *@
            <div class="container mt-2 mb-2 control-buttons">
                <div class="row ctrl">
                    <div class="col d-flex gap-2">

                        <button type="submit"
                                class="ctrl ctrl-save"
                                title="Save">
                            <i class="bi bi-floppy2-fill"></i>
                        </button>

                        <button type="button"
                                class="ctrl ctrl-back ms-auto"
                                title="Back"
                                @onclick="Back">
                            <i class="bi bi-arrow-left-circle-fill"></i>
                        </button>

                    </div>
                </div>
            </div>

        </div>

    </EditForm>
}
else
{
    <div class="alert alert-warning" role="alert">
        <p>
            User: [<strong>@UserName</strong>] is not authorized
            to edit application general settings.
        </p>
    </div>
}
