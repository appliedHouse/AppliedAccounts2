@* AppSetting.razor *@
@page "/Setting/General"
@using AppliedAccounts.Component.Libs

@attribute [Authorize]
@inject NavigationManager NavManager
@inject GlobalService AppGlobal

<PageHeading Text="General Setting" />

@code {

}

@if (IsAuthorized)
{
    <EditForm Model="MyModel" OnSubmit="SaveAsync">

        <div class="container">
            <div class="row">
                <div class="col-3">
                    <MyDropDown Id="ddCashNature"
                                Label="Cash Nature Account"
                                Value="@MyModel.CashNatureID"
                                ValueChanged="CashNatureValueChange"
                                Items="NatureList">
                    </MyDropDown>
                </div>
                <div class="col-3">
                    <MyDropDown Id="ddBankNature"
                                Label="Bank Nature Account"
                                Value="@MyModel.BankNatureID"
                                ValueChanged="BankNatureValueChange"
                                Items="NatureList">
                    </MyDropDown>
                </div>
            </div>
        </div>

    </EditForm>
}
else
{
    <div class="alert alert-warning" role="alert">
        <p> User : [<strong>@UserName</strong>] is not authorized to edit application general setting</p>
    </div>
}




