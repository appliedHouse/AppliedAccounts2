<!-- OffcanvasPanel.razor -->
@inject GlobalService AppGlobals
@inject IJSRuntime JS

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async void OnAfterRender(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await AppGlobals.JS.InvokeVoidAsync("initializeOffcanvas", "offcanvasRight");
            }

            if (IsOpen)
            {
                await AppGlobals.JS.InvokeVoidAsync("openOffcanvas", "offcanvasRight");
            }
            else
            {
                await AppGlobals.JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
            }
        }
        catch (Exception)
        {

        }
    }

    #region Close and open offcanvas
    private async Task CloseOffcanvas()
    {
        try
        {
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(IsOpen);
            await JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
        }
        catch (Exception)
        {
            // Handle exception if needed
        }

    }

    private async Task OpenOffcanvas()
    {
        try
        {
            IsOpen = true;
            await IsOpenChanged.InvokeAsync(IsOpen);
            await JS.InvokeVoidAsync("openOffcanvas", "offcanvasRight");
        }
        catch (Exception)
        {

        }

    }
    #endregion

    #region Opening Setting Components

    private void OpenUserSetting()
    {
        try
        {
            JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
            JS.InvokeVoidAsync("openModal", "Setting1");
            AppGlobals.NavManager.NavigateTo("/SettingUser");
        }
        catch (Exception)
        {

        }
    }

    private void OpenGeneralSetting()
    {
        try
        {
            JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
            JS.InvokeVoidAsync("openModal", "Setting2");
            AppGlobals.NavManager.NavigateTo("/SettingGeneral");
        }
        catch (Exception)
        {

        }
    }

    private void NavigateToConfig()
    {
        try
        {
            AppGlobals.NavManager.NavigateTo("/Config");
        }
        catch (Exception)
        {

        }
    }

    private void OpenBackup()
    {
        try
        {
            JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
            JS.InvokeVoidAsync("openModal", "Setting3");
            AppGlobals.NavManager.NavigateTo("/SettingBackup");
        }
        catch (Exception)
        {

        }
    }

    private void OpenResetPassword()
    {
        try
        {
            //JS.InvokeVoidAsync("closeOffcanvas", "offcanvasRight");
            //JS.InvokeVoidAsync("openModal", "Setting3");
            AppGlobals.NavManager.NavigateTo("/Users/ResetPassword");
        }
        catch (Exception)
        {

        }
    }
    #endregion
}

<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="offcanvasRight"
     aria-labelledby="offcanvasRightLabel"
     data-bs-backdrop="true"
     data-bs-scroll="false">
    <div class="offcanvas-header bg-dark text-white">
        <h5 class="offcanvas-title" id="offcanvasRightLabel">
            <i class="bi bi-gear me-2"></i>Settings
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close" @onclick="CloseOffcanvas"></button>
    </div>
    <div class="offcanvas-body">

        <!-- Actions -->
        <div class="mt-4 pt-3 border-top">
            <div class="d-grid gap-2">
                <button class="btn btn-primary" @onclick="OpenUserSetting">
                    <i class="bi bi-gear me-2"></i>User Profile
                </button>
                <!-- General Setting Button -->
                <button class="btn btn-primary" @onclick="OpenGeneralSetting">
                    <i class="bi bi-gear me-2"></i>General Setting
                </button>

                <button class="btn btn-primary" @onclick="OpenBackup">
                    <i class="bi bi-gear me-2"></i>Backup
                </button>

                <button class="btn btn-primary" @onclick="OpenResetPassword">
                    <i class="bi bi-gear me-2"></i>Reset Password
                </button>

                <!-- Configuration Page Button -->
                <button class="btn btn-outline-danger" @onclick="NavigateToConfig">
                    <i class="bi bi-box-arrow-right me-2"></i>Configuration Page
                </button>
            </div>
        </div>
    </div>
</div>

<SettingUser ModelName="Setting1"></SettingUser>
<SettingGeneral ModelName="Setting2"></SettingGeneral>
<SettingBackup ModelName="Setting3"></SettingBackup>

<script>
    // Offcanvas functions
    function initializeOffcanvas(id) {
        const element = document.getElementById(id);
        if (element) {
            return new bootstrap.Offcanvas(element, {
                backdrop: true,
                scroll: false
            });
        }
    }

    function openOffcanvas(id) {
        const element = document.getElementById(id);
        if (element) {
            const offcanvas = bootstrap.Offcanvas.getInstance(element) || new bootstrap.Offcanvas(element);
            offcanvas.show();
        }
    }

    function closeOffcanvas(id) {
        const element = document.getElementById(id);
        if (element) {
            const offcanvas = bootstrap.Offcanvas.getInstance(element);
            if (offcanvas) {
                offcanvas.hide();
            }
        }
    }

    // Generic modal function - this replaces both OpenGeneralSetting and OpenBackupSetting
    function openModal(id) {
        const element = document.getElementById(id);
        if (element) {
            var myModal = new bootstrap.Modal(element, {
                backdrop: 'static',
                keyboard: false
            });
            myModal.show();
        }
    }
</script>