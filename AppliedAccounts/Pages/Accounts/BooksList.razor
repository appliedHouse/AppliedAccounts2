@layout PageLayout
@page "/Accounts/BooksList"
@page "/Accounts/BooksList/{Nature:int}"
@attribute [Authorize]

@using AppliedAccounts.Component.ButtonsDictionery
@using AppliedAccounts.Component.Libs;
@using AppliedAccounts.Services

@inject IJSRuntime js
@inject GlobalService AppGlobal
@inject MessagesService MsgService
@inject IToastService Toaster

@code {

    [Parameter] public int? Nature { get; set; } = 1;
    private string DateFormat = Format.DDMMYY;
    private string CurrFormat = Format.Currency;
    private long SelectedVoucherID { get; set; }

    
}

<PageHeading Text="@MyModel.BookNatureTitle" />
<ShowMessages MsgService="MyModel.MsgService" />
<ShowPrintWait Visiable="@MyModel.IsWaiting" />

<EditForm Model="@MyModel">
    <div class="d-flex flex-row mb-3 filter align-items-center">
        <div class="p-2 ddwidth1">
            <MyDropDown id="ddNature"
                        Label="Account Nature"
                        Value="@MyModel.BookNatureID"
                        ValueChanged="@((e) => BookNatureChanged(e))"
                        Items="@MyModel.NatureAccountsList" />
        </div>
        <div class="p-2 ddwidth2">
            <MyDropDown id="ddBook"
                        Label="Book"
                        Value="@MyModel.BookID"
                        ValueChanged="@((e) => BookListChanged(e))"
                        Items="@MyModel.Source.GetBookAccounts(MyModel.BookNatureID)" />
        </div>

        <div class="p-2">
            <div class="field field-date">
                <label for="dateStat">From</label>
                <InputDate id="dateStat" class="item-height" @bind-Value="MyModel.DT_Start" />
            </div>
        </div>
        <div class="p-2">
            <div class="field field-date">
                <label for="dateEnd">To</label>
                <InputDate id="dateEnd" class="item-height" @bind-Value="MyModel.DT_End" />
            </div>
        </div>

        <div class="p-2 search-btn">
            <div class="field">
                <label for="txtSearch">Search</label>
                <InputText id="txtSearch" class="item-height" placeholder="Filter list"
                           @bind-Value="MyModel.SearchText"
                           @onclick="Refresh" />
            </div>
        </div>

        <div class="p-2 ms-auto d-flex align-items-center gap-2 filter-actions">
            <Btn_Refresh OnClick="Refresh" />
            <Btn_Add OnClick="New" />
        </div>
    </div>
    <div class="container">

        <table class="table-list">
            <thead>
                <tr>
                    <th style="width:10%">Voucher</th>
                    <th style="width:10%">Date</th>
                    <th style="width:5%">Sr.No</th>
                    <th style="width:35%">Description</th>
                    <th style="width:10%">Received</th>
                    <th style="width:10%">Paid</th>
                    <th style="width:10%">Balance</th>
                    <th style="width:10%">
                        <button class="btn btn-Add"><i class="bi bi-pencil-fill"></i></button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (BookView Record in MyModel.LoadBookRecords(MyModel.BookID))
                {
                    string _NavTo = $"/Accounts/Books/{Record.ID}/{MyModel.BookID}";
                    <tr>
                        <td>@Record.Vou_No</td>
                        <td>@Record.Vou_Date.ToString(Format.DDMMMYY)</td>
                        <td class="center">@Record.Sr_No</td>
                        <td class="left">@Record.Description</td>
                        <td class="amount">@Record.TReceived</td>
                        <td class="amount">@Record.TPaid</td>
                        <td class="amount">@Record.TBalance</td>
                        <td>
                            <Btn1_Edit OnClick="(()=>Edit(Record.ID))"/>
                            @* <EditButton NavTo=@_NavTo Title="Edit Voucher" /> *@
                            <PrintButton ReturnValue="Print" VoucherID=Record.ID />

                            @if (Record.Status == Status.Submitted.ToString())
                            {
                                <DeleteButton OnClick="@(() => ShowDeleteModal(Record.ID))"
                                              UserRole="@AppGlobal.UserRole" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex">
            <div class="p-1" style="height:40px">
                <NavPageBar Paging="MyModel.Pages"></NavPageBar>
            </div>
        </div>

    </div>


</EditForm>


<div class="modal fade"
     id="DeleteVoucher"
     tabindex="-1"
     aria-labelledby="DeleteVoucherLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="DeleteVoucherLabel">
                    Confirm Voucher Deletion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete voucher
                <strong>@SelectedVoucherID</strong>?

                <p class="text-danger mt-2 mb-0">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        @onclick="DeleteVoucher">
                    <i class="bi bi-trash"></i>
                    Delete
                </button>
            </div>

        </div>
    </div>
</div>





<style>
    .filter {
        background-color: antiquewhite;
        margin: 3px 15px;
        padding: 8px 10px;
        min-height: 76px;
        display: flex;
        align-items: center;
        border-radius: 6px;
    }

    .ddwidth1 {
        width: 190px;
    }

    .ddwidth2 {
        width: 290px;
    }

    .search-btn {
        flex: 1;
    }

  
    .field {
        position: relative;
        height: 56px;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        transition: border-color .15s, box-shadow .15s;
    }

        .field:focus-within {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,.15);
        }

    .field-date {
        width: 170px;
    }

    .field label {
        position: absolute;
        top: 6px;
        left: 12px;
        margin: 0;
        font-size: 12px;
        color: #6c757d;
        pointer-events: none;
    }

    .field .item-height {
        width: 100%;
        height: 100%;
        border: none;
        outline: none;
        background: transparent;
        padding: 22px 12px 4px 12px;
        font-size: 15px;
        box-sizing: border-box;
        border-radius: 6px;
    }


    .filter-actions .btn,
    .filter-actions button {
        height: 48px;
        min-width: 48px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .filter-actions button:first-child {
            background: #fff;
            border: 1px solid #dee2e6;
            box-shadow: 0 1px 2px rgba(0,0,0,.05);
        }
</style>