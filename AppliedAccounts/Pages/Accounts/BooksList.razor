@layout PageLayout;
@page "/Accounts/BooksList";
@page "/Accounts/BooksList/{Nature:int}";
@attribute [Authorize];

@using AppliedAccounts.Component.Libs;
@using AppliedAccounts.Services

@inject IJSRuntime js
@inject GlobalService AppGlobal
@inject MessagesService MsgService
@inject IToastService Toaster

@code {

    [Parameter] public int? Nature { get; set; } = 0;
    private string DateFormat = Format.DDMMYY;
    private string CurrFormat = Format.Currency;


    protected override void OnInitialized()
    {
        MyModel = new(0, AppGlobal, MsgService);   // BookID and UserProfile.
        MyModel.GetKeys();
        NavManager = AppGlobal.NavManager;

        if(Nature != null)
        {
            BookNatureChanged((long)Nature); 
        }
    }

    

    
}

<PageHeading Text="@MyModel.BookNatureTitle"/>
<ShowMessages MsgService="MyModel.MsgService"/>
<ShowPrintWait Visiable="@MyModel.IsWaiting"/>

<EditForm Model="@MyModel">
    <div class="d-flex flex-row mb-3 filter">
        <div class="p-2">
            <MyDropDown id="ddNature"
                        Label="Account Nature"
                        Value="@MyModel.BookNatureID"
                        ValueChanged="@((e) => BookNatureChanged(e))"
                        Items="@MyModel.NatureAccountsList"
                        />
        </div>
        <div class="p-2">
            <MyDropDown id="ddBook"
                        Label="Book"
                        Value="@MyModel.BookID"
                        ValueChanged="@((e) => BookListChanged(e))"
                        Items="@MyModel.Source.GetBookAccounts(MyModel.BookNatureID)"/>
        </div>
        <div class="p-2">
            <InputDate id="dateStat" class="item-height" @bind-Value="MyModel.DT_Start"></InputDate>
        </div>
        <div class="p-2">
            <InputDate id="dateEnd" class="item-height" @bind-Value="MyModel.DT_End"></InputDate>
        </div>
        <div class="p-2 search-btn">
            <label for="floatingInput">
                <InputText id="txtSearch" class="item-height" placeholder="Filter list"
                           @bind-Value="MyModel.SearchText"
                           @onclick="Refresh">
                </InputText>
            </label>
        </div>
        <div class="p-2">
            <Btn_Refresh OnClick="Refresh"/>
            <Btn_Add OnClick="New"/>
        </div>
        
    </div>

    <div class="container">
       
            <table class="table-list">
                <thead>
                    <tr>
                        <th style="width:10%">Voucher</th>
                        <th style="width:10%">Date</th>
                        <th style="width:5%">Sr.No</th>
                        <th style="width:35%">Description</th>
                        <th style="width:10%">Received</th>
                        <th style="width:10%">Paid</th>
                        <th style="width:10%">Balance</th>
                        <th style="width:10%">
                            <button class="btn btn-Add"><i class="bi bi-pencil-fill"></i></button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BookView Record in MyModel.LoadBookRecords(MyModel.BookID))
                    {
                        string _NavTo = $"/Accounts/Books/{Record.ID}/{MyModel.BookID}";
                        <tr>
                            <td>@Record.Vou_No</td>
                            <td>@Record.Vou_Date.ToString(Format.DDMMMYY)</td>
                            <td class="center">@Record.Sr_No</td>
                            <td class="left">@Record.Description</td>
                            <td class="amount">@Record.TReceived</td>
                            <td class="amount">@Record.TPaid</td>
                            <td class="amount">@Record.TBalance</td>
                            <td>
                                <EditButton NavTo=@_NavTo Title="Edit Voucher" />
                                <PrintButton ReturnValue="Print" VoucherID=Record.ID />

                                @if (Record.Status == Status.Submitted.ToString())
                                {
                                    <DeleteButton OnClick="@(()=>DeleteVoucher(Record.ID))" UserRole="@AppGlobal.UserRole"  />
                                }
                        </td>
                        </tr>
                    }
                </tbody>
            </table>

             <div class="d-flex">
                   <div class="p-1" style="height:40px">
                       <NavPageBar Paging="MyModel.Pages"></NavPageBar>
                   </div>
            </div>
       
    </div>
    
</EditForm>
