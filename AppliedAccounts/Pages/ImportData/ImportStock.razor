@page "/ImportInventory"
@using System.Data
@using AppliedAccounts.Component.ButtonsDictionery
@using AppliedAccounts.Component.Libs
@using AppliedAccounts.Models.Import
@using AppliedAccounts.Services

@attribute [Authorize]
@inject GlobalService AppGlobal
@inject MessagesService MsgService

@code {
    private bool PageIsValid { get; set; }
    private string MyMessage { get; set; } = string.Empty;
    public string ExcelFileName { get; set; } = "";

    public bool Step1 { get; set; } = true;  // Step 1: Loading Excel file
    public bool Step2 { get; set; } = false; // Step 2: Loaded Excel file data
    public bool Step3 { get; set; } = false; // Step 3: Display Excel file data
    public bool Step4 { get; set; } = false; // Step 4: Post / Save invoices to Database
    public bool StepError { get; set; } = false;

    protected override void OnInitialized()
    {
        MyModel = new ImportStockModel(AppGlobal, MsgService);


        PageIsValid = true;
        if (AppGlobal is null) { PageIsValid = false; }
        if (MyModel is null) { PageIsValid = false; }
    }

    private async Task TriggerFileInput()
    {
        await AppGlobal.JS.InvokeVoidAsync("triggerFileUpload");

    }

    private async Task ViewStock()
    {
        // show bootstrap model.
    }
}

<PageHeading Text="Import Inventory (Stock) List" />
<ShowMessages MsgService="MyModel.MsgService" />



@if (Step1)
{
    <div class="container">
        <div class="d-flex flex-row mb-3">
            <div class="p-2">
                <button class="btn btn-primary w1" disabled="@(MyModel.IsExcelLoaded)"
                        title="Upload Excel file" @onclick="TriggerFileInput">
                    Upload Excel file
                </button>
                <InputFile id="inputFile" class="d-none" OnChange="GetExcelFile" />


            </div>
            <div class="p-2">
                <label>@ExcelFileName</label>
            </div>
            @if (MyModel.IsExcelLoaded)
            {
                <div class="p-2">
                    <label>Excel File has been loaded successfully.</label>
                </div>
            }

        </div>
    </div>
}

@if (Step2)
{
    <ShowSpinner Message="@SpinnerMessage" Type="@SpinnerType" />
}


@if (Step3)
{
    if (MyModel.IsDataLoaded)
    {
        <div class="table-container">
            <table class="table-list">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Title</th>
                        <th>
                            <Btn1_Post OnClick="MyModel.ImportInDB" />
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (MyModel.ImportedData.Count > 0)
                    {
                        @foreach (DataRow row in MyModel.ImportedData)
                        {
                            <tr>
                                <td>@row["Code"]</td>
                                <td>@row["Title"]</td>
                                <td><Btn1_View OnClick="ViewStock" /></td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>
                                <p>No Records Found....</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        SpinnerMessage = "Data is not loaded...";
        SpinnerType = "Warrning";
    }

}

@if (Step4)
{
    <p>Shows messages of import data</p>
}

@if (StepError)
{
    <div class="alert alert-danger" role="alert">
        Data Import has error. 
        Check Excel Data File or contect to administrator
    </div>
}