@page "/ImportData"

@using AppliedAccounts.Component.Libs
@using AppliedAccounts.Services
@using ToastNotificationLibrary.Services
@using AppliedDB

@inject GlobalService AppGlobals
@inject NavigationManager NavManager
@inject ToastService Toaster
@inject IJSRuntime JSRuntime

@code {
    private DataSource? Source { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Source = new(AppGlobals.AppPaths);
    }

    private void ImportAccount()
    {
        NavManager.NavigateTo("/ImportCOA");
    }
    private void ImportStock()
    {
        NavManager.NavigateTo("/ImportInventory");
    }
    private void ImportStockPrice()
    {
        NavManager.NavigateTo("/ImportStockPrice");
    }
}

<PageHeading Text="Import Data" />


<div class="container">
    <div class="row">
        <div class="col">
            <button class="btn btn-primary" @onclick="ImportAccount">Import COA</button>
        </div>
        <div class="col">
            <button class="btn btn-primary" @onclick="ImportStock">Import Inventory</button>
        </div>
        <div class="col">
            <button class="btn btn-primary" @onclick="ImportStockPrice">Import Stock Price</button>
        </div>

    </div>
</div>